# =============================================
# BlackChat — Instagram Automation
# Environment Variables Template
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================

# =============================================
# Meta / Facebook Developer App
# Get these from https://developers.facebook.com/apps/
# =============================================

# Your Meta App ID (public, shown in App Dashboard)
META_APP_ID=

# Your Meta App Secret (KEEP THIS SECRET — never expose to browser)
META_APP_SECRET=

# The verify token you set in Meta Webhook configuration.
# Choose any random string (e.g. output of: openssl rand -hex 16)
META_VERIFY_TOKEN=

# The full HTTPS redirect URI for OAuth callback.
# For local dev: use your Cloudflare Tunnel URL
# Example: https://my-tunnel.trycloudflare.com/api/instagram/callback
META_REDIRECT_URI=

# Meta Graph API version — update as Meta releases new versions.
# Current stable as of 2026: v22.0 (update to v26.0+ if needed)
# Check: https://developers.facebook.com/docs/graph-api/changelog/
META_GRAPH_API_VERSION=v22.0

# =============================================
# Supabase
# Get these from your Supabase project settings > API
# =============================================

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (NEVER expose to browser — server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# =============================================
# Security
# =============================================

# 32-byte (64 hex char) key for AES-256-GCM token encryption.
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=

# =============================================
# App
# =============================================

# The full URL where the app is running.
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
